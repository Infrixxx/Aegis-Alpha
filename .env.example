# Aegis Alpha Environment Configuration Template
# Copy this file to .env and populate your own credentials.
# Never commit .env to version control.

# Telegram Bot Credentials (optional; falls back to console logging if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance API Credentials (optional; falls back to dry-run order simulation if empty)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Broker Execution Mode (true = Binance Spot Testnet / Dry-Run, false = Live)
BINANCE_TESTNET=true

# Storage and Logging
DATABASE_PATH=data/market_data.db
LOG_LEVEL=INFO
